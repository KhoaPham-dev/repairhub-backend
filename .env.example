DATABASE_URL=postgresql://postgres:password@localhost:5432/repairhub
JWT_SECRET=your-secret-key-change-in-production
PORT=6061
NODE_ENV=development
UPLOAD_DIR=uploads

# Agent API (/api/agent/*) — read-only, consumed by repairhub-mcp (ADR-0009).
# BOTH of the following must be set, or the entire Agent API is disabled
# (every /api/agent/* route returns 404, same as when AGENT_API_KEY alone is
# missing — a relative media URL is useless to an external AI agent, so a
# missing/invalid PUBLIC_MEDIA_BASE_URL disables the API too). A startup
# warning is logged (never the key) if either is missing/invalid.
AGENT_API_KEY=
# Absolute http(s) base URL used to build public media URLs in Agent API
# responses, e.g. https://media.example.com (trailing slash is normalised
# away automatically, but omit it here). Must be a valid absolute http(s)
# URL or the Agent API is disabled — see above.
PUBLIC_MEDIA_BASE_URL=

# In the tunnel deployment, requests reach the server through `cloudflared`
# on loopback, so the socket IP isn't the real client IP. Set to "true" only
# once you've confirmed ALL traffic is tunnel-only, to trust the
# CF-Connecting-IP header for Agent API request logging/rate limiting
# (falls back to req.ip when unset/false — this header is trivially
# spoofable by anyone who can reach the server directly).
TRUST_CLOUDFLARE_IP=false

# Agent API rate limiting (NFR-08.4). Global per-IP bound on all
# /api/agent/* traffic, regardless of outcome. Defaults: 120 requests per
# 60000ms (1 minute).
AGENT_API_RATE_LIMIT_WINDOW_MS=60000
AGENT_API_RATE_LIMIT_MAX=120
# Stricter per-IP bound counting ONLY failed-auth (401) responses, so a
# brute-forced or leaked key is bounded independently of normal traffic.
# Defaults: 20 failed attempts per 900000ms (15 minutes).
AGENT_API_AUTH_FAIL_WINDOW_MS=900000
AGENT_API_AUTH_FAIL_LIMIT_MAX=20
