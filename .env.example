DATABASE_URL=postgresql://postgres:password@localhost:5432/repairhub
JWT_SECRET=your-secret-key-change-in-production
PORT=6061
NODE_ENV=development
UPLOAD_DIR=uploads

# Agent API (/api/agent/*) — read-only, consumed by repairhub-mcp (ADR-0009).
# Unset = Agent API disabled (404 on every /api/agent/* route).
AGENT_API_KEY=
# Absolute base URL used to build public media URLs in Agent API responses,
# e.g. https://media.example.com (no trailing slash). Empty = relative URLs.
PUBLIC_MEDIA_BASE_URL=
